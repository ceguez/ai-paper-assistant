# Copy to .env and adjust. Every setting is optional.

# Runtime: "ollama" (default) or "openai" for LM Studio (:1234) or mlx_lm.server (:8080)
PA_RUNTIME=ollama
# PA_BASE_URL=http://127.0.0.1:1234

# Hardware profile for a 24 GB M4 Pro:
#   balanced  7-8B at Q4_K_M, 16k context (default, ~6 GB)
#   quality   14B at Q4_K_M, 8k context (~10.5 GB, about half the speed)
#   fast      3B at Q4_K_M, 16k context (~3 GB)
PA_PROFILE=balanced
# Pin a model instead of auto-detecting from what you have pulled:
# PA_GEN_MODEL=qwen2.5:7b-instruct
# PA_EMBED_MODEL=nomic-embed-text
# PA_NUM_CTX=16384

# PDF parser: auto (docling if installed, else pymupdf4llm) | docling | pymupdf4llm
PA_PARSER=auto

# After each answer, distil durable facts into memory (one extra model call).
PA_MEMORY_EXTRACTION=true

# Where papers, the database and logs live
# PA_DATA_DIR=./data
# PA_HOST=127.0.0.1
# PA_PORT=8000
